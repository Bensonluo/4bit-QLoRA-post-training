{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["index", "reasoning", "matched", "confidence"],
    "properties": {
      "index": {
        "type": "integer",
        "minimum": 1,
        "description": "候选机构在列表中的序号"
      },
      "reasoning": {
        "type": "string",
        "description": "匹配推理过程，如 P1(通过)->P2(冲突)->判定false"
      },
      "matched": {
        "type": "boolean",
        "description": "是否匹配同一物理实体"
      },
      "confidence": {
        "type": "string",
        "enum": ["High", "Medium", "Low"],
        "description": "匹配置信度"
      }
    },
    "additionalProperties": false
  }
}