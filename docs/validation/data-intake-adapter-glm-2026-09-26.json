      "source_code": "import re\n\ndef transform(rows, config):\n    START = config.get(\"start_marker\", \"【客户原话】\")\n    END = config.get(\"end_marker\", \"【内部记录】\")\n    out = []\n    for row in rows:\n        new = dict(row)\n        rid = row.get(\"__row_id\", \"?\")\n        log = row.get(\"log\")\n        if not isinstance(log, str):\n            raise ValueError(f\"行{rid}: log 不是文本，无法提取客户原话\")\n        s = log.find(START)\n        if s == -1:\n            raise ValueError(f\"行{rid}: log 缺少开始标记 {START}，拒绝猜测\")\n        content_start = s + len(START)\n        e = log.find(END, content_start)\n        if e == -1:\n            raise ValueError(f\"行{rid}: log 缺少结束标记 {END}，拒绝猜测\")\n        words = log[content_start:e].strip()\n        new[\"customer_first_words\"] = words\n        out.append(new)\n    return out"
    },
